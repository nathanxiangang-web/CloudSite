# CloudSite 环境变量示例。复制为 .env 并替换占位值。

# 会话签名密钥（必填）：用于后台会话签名与凭据加密回退。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
CLOUDSITE_SECRET_KEY=replace-with-a-long-random-secret

# 可选独立主密钥：优先用于加密 AList 凭据，为空时回退到 CLOUDSITE_SECRET_KEY。
# 一旦写入并保存过 AList 凭据，请勿再改动，否则已保存凭据无法解密。
CLOUDSITE_MASTER_KEY=

# 数据目录（Docker 内保持 /data；本地运行可指向项目 data/ 目录）。
CLOUDSITE_DATA_DIR=/data

# CORS 允许来源（逗号分隔）。前端通过同源 rewrite 访问 API，通常无需额外跨域。
CLOUDSITE_CORS_ORIGINS=http://localhost:3000

# 只有这些直接代理网段可提供 X-Forwarded-For。默认信任本机与 Docker 172.16/12，
# 不要把普通客户端所在的整个局域网网段加入此列表。
CLOUDSITE_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12

# Web 监听地址与端口。仅供本机反代时可把 BIND 改为 127.0.0.1。
CLOUDSITE_WEB_BIND=0.0.0.0
CLOUDSITE_WEB_PORT=3000

# 宿主机数据目录。相对路径以 Compose 文件所在目录为基准。
CLOUDSITE_DATA_PATH=./data

# 前端（Next.js）运行时变量。
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_SITE_NAME=CloudSite

# Traefik 部署参数；只有使用 docker-compose.traefik.yml 时需要。
CLOUDSITE_DOMAIN=cloud.example.com
TRAEFIK_NETWORK=my-servers_app-net
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=myresolver

# 生产镜像。默认从公开 GHCR 包拉取；建议生产环境固定版本标签，而不是长期使用 latest。
CLOUDSITE_API_IMAGE=ghcr.io/nathanxiangang-web/cloudsite-api
CLOUDSITE_WEB_IMAGE=ghcr.io/nathanxiangang-web/cloudsite-web
CLOUDSITE_IMAGE_TAG=v0.5.1

# 缺失对象必须连续经过两次独立完整扫描才标记为 missing。
CLOUDSITE_SYNC_MISSING_CONFIRM_RUNS=2

# Office 在线预览：本地缓存文件的有效期（秒，默认 3600 = 1 小时）与单文件大小上限（字节，默认 200MB）。
CLOUDSITE_OFFICE_CACHE_TTL_SECONDS=3600
CLOUDSITE_OFFICE_CACHE_MAX_BYTES=209715200
